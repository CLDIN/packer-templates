{
    "variables": {
        "name": "almalinux-10",
        "url": "http://compute.o.auroraobjects.eu/iso/AlmaLinux-10.0-x86_64-boot.iso",
        "iso_checksum": "a1549729bfb66a28e3546c953033c9928eae7280917bb1c490983dba3bb9941c",
        "boot_command": "<esc><wait><esc><wait>e<down><down><end> inst.text inst.ks=http://{{ .HTTPIP }}:{{ .HTTPPort }}/kickstart/almalinux-10.ks<wait><f10>"
    },
    "builders": [
        {
            "type": "qemu",
            "iso_url": "{{user `url`}}",
            "iso_checksum": "{{user `iso_checksum`}}",
            "vm_name": "{{user `name`}}",
            "format": "qcow2",
            "accelerator": "kvm",
            "headless": true,
            "shutdown_timeout": "15s",
            "shutdown_command": "echo 'RvHtrfTwCjTnhHrD' | sudo -S shutdown -P now",
            "cpus": 2,
            "qemuargs": [
                ["-cpu", "host,+nx"]
            ],
            "memory": 2048,
            "disk_size": "8G",
            "disk_interface": "virtio-scsi",
            "disk_discard": "unmap",
            "disk_compression": true,
            "boot_command": "{{user `boot_command`}}",
            "communicator": "ssh",
            "vnc_bind_address": "[::]",
            "ssh_wait_timeout": "30m",
            "ssh_username": "root",
            "ssh_password": "RvHtrfTwCjTnhHrD",
            "http_directory": "files",
            "http_port_min": 8000,
            "http_port_max": 8100,
            "output_directory": "build_{{user `name`}}"
        }
    ],
    "provisioners": [
        {
            "type": "file",
            "source": "files/generic/cloud-init.cfg",
            "destination": "/etc/cloud/cloud.cfg"
        },
        {
            "type": "file",
            "source": "files/generic/watchdog.conf",
            "destination": "/etc/watchdog.conf"
        },
        {
            "type": "file",
            "source": "files/generic/99-disable-ipv6-tempaddr.conf",
            "destination": "/etc/sysctl.d/99-disable-ipv6-tempaddr.conf"
        },
        {
            "type": "file",
            "source": "files/generic/99-hotPlugCPU.rules",
            "destination": "/etc/udev/rules.d/99-hotPlugCPU.rules"
        },
        {
            "type": "file",
            "source": "files/centos/90-dns-none.conf",
            "destination": "/etc/NetworkManager/conf.d/90-dns-none.conf"
        },
        {
            "type": "file",
            "source": "files/centos/grub",
            "destination": "/etc/default/grub"
        },
        {
            "type": "file",
            "source": "files/patches/DataSourceCloudStack.patch",
            "destination": "/tmp/DataSourceCloudStack.patch"
        },
        {
            "type": "file",
            "source": "files/patches/net_dhcp.patch",
            "destination": "/tmp/net_dhcp.patch"
        },
        {
            "type": "shell",
            "scripts":
            [
                "scripts/almalinux-10/post.sh"
            ],
            "execute_command": "sh '{{.Path}}'"
        },
        {
            "type": "shell",
            "inline":
            [
              "fstrim -v /"
            ]
        }
    ],
    "post-processors": [
        [
            {
                "type": "shell-local",
                "command": "mv build_{{user `name`}}/{{user `name`}} build_{{user `name`}}/{{user `name`}}.qcow2"
            },
            {
                "type": "artifice",
                "files": [
                    "build_{{user `name`}}/{{user `name`}}.qcow2"
                ]
            },
            {
                "type": "checksum",
                "checksum_types": [
                    "sha256"
                ],
                "output": "build_{{user `name`}}/{{user `name`}}.checksum"
            },
            {
                "type": "manifest",
                "output": "build_{{user `name`}}/{{user `name`}}.json",
                "strip_path": true,
                "custom_data": {
                    "oscategory": "{{split (user `name`) \"-\" 0}}",
                    "osversion": "{{split (user `name`) \"-\" 1}}",
                    "template_slug": "{{user `name`}}"
                }
            }
        ]
    ]
}
